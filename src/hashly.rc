#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_PAGE DIALOGEX 0, 0, 252, 218
STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CLIPSIBLINGS
FONT 9, "Segoe UI"
BEGIN
    CONTROL     "", IDC_SCORE, "Static", SS_OWNERDRAW, 7, 7, 48, 48
    LTEXT       "", IDC_VERDICT, 62, 8, 183, 22, SS_NOPREFIX
    LTEXT       "", IDC_INFO, 62, 31, 183, 28, SS_NOPREFIX
    CONTROL     "", IDC_BAR, "Static", SS_OWNERDRAW, 7, 63, 238, 5
    CONTROL     "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP, 7, 74, 238, 116
    EDITTEXT    IDC_DETAILS, 7, 74, 238, 116, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON  "Check again", IDC_RESCAN, 7, 196, 60, 14
    PUSHBUTTON  "Open on VirusTotal", IDC_OPENWEB, 72, 196, 80, 14
    PUSHBUTTON  "API key file...", IDC_SETKEY, 157, 196, 70, 14
END
